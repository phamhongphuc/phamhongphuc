{
  "name": "@phamhongphuc/monorepo",
  "version": "0.0.0",
  "description": "phamhongphuc's Monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phamhongphuc/phamhongphuc.git"
  },
  "bugs": {
    "url": "https://github.com/phamhongphuc/phamhongphuc/issues"
  },
  "homepage": "https://github.com/phamhongphuc/phamhongphuc#readme",
  "author": "phamhongphuc",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "🚀 ----- NX ----- 🚀": "",
    "clean": "nx run-many -t clean --exclude monorepo",
    "gen": "nx run-many -t gen --exclude monorepo",
    "build": "nx run-many -t build --exclude monorepo",
    "test": "nx run-many -t test --exclude monorepo",
    "🦋 ----- CHANGESET ----- 🦋": "",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile",
    "🧹 ----- LINT ----- 🧹": "",
    "es-config": "eslint-config-inspector",
    "lint": "nx run-many -t lint:md lint:es lint:css lint:prettier",
    "lint:md": "markdownlint-cli2",
    "lint:es": "eslint --flag unstable_ts_config",
    "lint:css": "stylelint '**/*.{vue,css,scss}' --allow-empty-input",
    "lint:prettier": "prettier \"**\" --check --ignore-path .prettierignore.project",
    "🧹 ----- FIX ----- 🧹": "",
    "fix": "nx run-many -t fix:md fix:es fix:css fix:prettier --parallel 1",
    "fix:md": "markdownlint-cli2 --fix",
    "fix:es": "eslint --flag unstable_ts_config --fix",
    "fix:css": "stylelint '**/*.{vue,css,scss}' --allow-empty-input --fix",
    "fix:prettier": "prettier \"**\" --write --ignore-path .prettierignore.project",
    "🔃 ----- LIFE CYCLE ----- 🔃": "",
    "prepare": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "volta": {
    "node": "22.13.1",
    "pnpm": "10.3.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": "10.3.0"
  },
  "packageManager": "pnpm@10.3.0",
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "@culur/changesets-changelog-github": "^1.1.3",
    "@culur/config-eslint": "1.2.5",
    "@culur/config-prettier": "1.3.3",
    "@culur/config-stylelint": "1.3.7",
    "@culur/config-typescript": "1.1.1",
    "@eslint-react/eslint-plugin": "^1.34.1",
    "@eslint/config-inspector": "^1.0.2",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "@vitest/ui": "^3.0.8",
    "dotenv": "^16.4.7",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "markdownlint": "^0.37.4",
    "markdownlint-cli2": "^0.17.2",
    "nx": "20.6.0",
    "pinst": "^3.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-embed": "^0.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "rimraf": "^6.0.1",
    "stylelint": "^16.16.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.8"
  }
}
